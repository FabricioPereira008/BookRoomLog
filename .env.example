# Configurações do BookRoomLog API

# Chave opcional da API do Google Books (busca de dados e capas). Sem ela a cota é compartilhada e pequena;
# também dá para informar a chave pelo app, em Configurações → Busca e capas.
GOOGLE_BOOKS_API_KEY=

# Pasta dos dados (banco, capas, backups). Padrão: pasta backend/ em desenvolvimento; ~/.local/share/bookroomlog no app empacotado
# BOOKROOM_DATA_DIR=

# Porta da API local (padrão 8010; o GameRoomLog usa a 8000)
# BOOKROOM_PORT=8010
